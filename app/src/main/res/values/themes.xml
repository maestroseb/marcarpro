<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MarcarPro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorControlHighlight">#22FFFFFF</item>
    </style>

    <!-- The launcher never draws: it starts the ink layer and finishes at once. -->
    <style name="Theme.MarcarPro.Launcher" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
