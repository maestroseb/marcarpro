<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb drive the panel's touch areas for experiments (only the shell,
     which holds DUMP, may send to it). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name=".DebugPanelReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.maestroseb.marcarpro.DEBUG_AREA" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
